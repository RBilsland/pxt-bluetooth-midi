{
    "name": "bluetooth-midi",
    "version": "2.0.21",
    "description": "A Bluetooth MIDI service",
    "license": "MIT",
    "dependencies": {
        "core": "*",
        "bluetooth": "*",
        "midi": "github:microsoft/pxt-midi#v2.1.11"
    },
    "files": [
        "README.md",
        "bluetooth.ts",
        "BluetoothMIDIService.cpp",
        "BluetoothMIDIService.h",
        "midi.cpp",
        "shims.d.ts",
        "enums.d.ts"
    ],
    "testFiles": [
        "tests.ts"
    ],
    "public": true,
    "installedVersion": "workspace:ba1a3850-63c9-4062-aab8-393d43dccbb2",
    "yotta": {
        "config": {
            "microbit-dal": {
                "bluetooth": {
                    "enabled": 1,
                    "open": 1,
                    "whitelist": 0
                },
                "gatt_table_size": "0x800"
            }
        },
        "userConfigs": [
            {
                "description": "Just Works pairing (encrypted link, try if open mode fails on Mac)",
                "config": {
                    "microbit-dal": {
                        "bluetooth": {
                            "open": 0,
                            "whitelist": 0,
                            "security_level": "SECURITY_MODE_ENCRYPTION_NO_MITM"
                        }
                    }
                }
            }
        ]
    }
}
